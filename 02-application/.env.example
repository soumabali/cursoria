# Native Next.js: npm run dev:next / npm run build:next / npm run start:next
APP_URL=http://localhost:3000
# Neon PostgreSQL connection URL (use a least-privilege application role)
DATABASE_URL=
# First account matching this email is assigned superadmin during email verification.
SUPERADMIN_EMAIL=
# Resend: verified sending domain required
EMAIL_API_KEY=
EMAIL_FROM=
# Generate 32 random bytes as 64 hex characters; keep in your secret manager.
SETTINGS_ENCRYPTION_KEY=
# Private S3-compatible bucket, e.g. Cloudflare R2
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Enable indexing only after replacing sample content and publishing store policies.
STORE_PUBLIC=false
